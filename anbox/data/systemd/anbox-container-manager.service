[Unit]
Description=Anbox Reboxed Container Manager
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/anbox/android.img
ConditionPathExists=/var/lib/anbox/vendor.img

[Service]
Type=simple
EnvironmentFile=-/etc/anbox/container-manager.conf
ExecStartPre=/usr/local/lib/anbox/prepare-host.sh --gsi
ExecStartPre=/usr/local/lib/anbox/anbox-bridge.sh start
ExecStart=/usr/local/bin/anbox-reboxed container-manager --daemon --privileged --android-image=${ANBOX_ANDROID_IMAGE} --vendor-image=${ANBOX_VENDOR_IMAGE} --data-path=${ANBOX_DATA_PATH}
ExecStopPost=/usr/local/lib/anbox/anbox-bridge.sh stop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
