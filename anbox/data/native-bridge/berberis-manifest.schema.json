{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anbox-reboxed.invalid/schemas/berberis-manifest-v1.json",
  "title": "Anbox Reboxed built-in Berberis backend manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "backend_id",
    "backend_kind",
    "backend_version",
    "translator",
    "host_arch",
    "guest_arch",
    "detected_abis",
    "native_bridge_interface_versions",
    "source_revision",
    "files"
  ],
  "properties": {
    "schema": { "const": 1 },
    "backend_id": { "const": "berberis" },
    "backend_kind": { "const": "builtin-image" },
    "backend_version": { "type": "string", "minLength": 1 },
    "translator": { "const": "libberberis_arm64.so" },
    "host_arch": { "const": "x86_64" },
    "guest_arch": { "const": "arm64" },
    "detected_abis": {
      "type": "array",
      "prefixItems": [{ "const": "arm64-v8a" }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "native_bridge_interface_versions": {
      "type": "array",
      "prefixItems": [{ "const": 7 }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "source_revision": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size", "mode"],
        "properties": {
          "path": { "type": "string", "pattern": "^/system/" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "mode": { "type": "integer", "enum": [420, 493] }
        }
      }
    }
  }
}
