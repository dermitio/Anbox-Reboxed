#!/usr/bin/env bash
set -euo pipefail

orientation="${ANBOX_ORIENTATION:-portrait}"
width="${ANBOX_WIDTH:-}"
height="${ANBOX_HEIGHT:-}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/anbox/window.conf"
lock="${XDG_RUNTIME_DIR:-/tmp}/anbox-window-${UID}.lock"
if command -v anbox-reboxed >/dev/null 2>&1; then
  ANBOX_BIN=anbox-reboxed
else
  ANBOX_BIN=anbox
fi

error() {
  local message="$1"
  command -v notify-send >/dev/null && notify-send -u critical "Anbox Reboxed startup failed" "$message" || true
  printf 'Anbox Reboxed startup failed: %s\n' "$message" >&2
  exit 1
}

usage() {
  echo "Usage: anbox-reboxed-window [--orientation portrait|landscape|auto] [--width PX] [--height PX] [--save]"
  echo "       anbox-window remains available as a compatibility alias"
}

save=0
orientation_explicit=0
while (($#)); do
  case "$1" in
    --orientation) orientation="${2:?missing orientation}"; orientation_explicit=1; shift 2 ;;
    --width) width="${2:?missing width}"; shift 2 ;;
    --height) height="${2:?missing height}"; shift 2 ;;
    --save) save=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) error "Unknown option: $1" ;;
  esac
done

case "$orientation" in portrait|landscape|auto) ;; *) error "Invalid orientation: $orientation" ;; esac
if [[ -r "$config" ]]; then
  requested_orientation="$orientation"
  # shellcheck source=/dev/null
  source "$config"
  orientation="${ANBOX_ORIENTATION:-$orientation}"
  width="${ANBOX_WIDTH:-$width}"
  height="${ANBOX_HEIGHT:-$height}"
  if ((orientation_explicit)); then orientation="$requested_orientation"; width=""; height=""; fi
fi

status="$("$ANBOX_BIN" display-status 2>&1)" || error "$status"
desktop="$(sed -n 's/^desktop-size: //p' <<<"$status")"
desktop_w="${desktop%x*}"; desktop_h="${desktop#*x}"

choose_resolution() {
  local layout="$1"
  local available_w=$((desktop_w - 80))
  local available_h=$((desktop_h - 80))
  local candidate_w candidate_h

  # Prefer standard 16:9 Android framebuffers instead of deriving arbitrary
  # pixel sizes from the desktop height. The smaller presets keep the entire
  # decorated window visible on common 1080p and compact laptop displays.
  if [[ "$layout" == portrait ]]; then
    for candidate_w in 720 540 360; do
      candidate_h=$((candidate_w * 16 / 9))
      if ((candidate_w <= available_w && candidate_h <= available_h)); then
        width="$candidate_w"; height="$candidate_h"
        return
      fi
    done
  else
    for candidate_h in 720 540 360; do
      candidate_w=$((candidate_h * 16 / 9))
      if ((candidate_w <= available_w && candidate_h <= available_h)); then
        width="$candidate_w"; height="$candidate_h"
        return
      fi
    done
  fi

  # Very small desktops still get a valid 16:9 framebuffer, rounded down to
  # even dimensions for graphics stacks that require chroma-plane alignment.
  if [[ "$layout" == portrait ]]; then
    height=$((available_h / 2 * 2)); width=$((height * 9 / 16 / 2 * 2))
  else
    width=$((available_w / 2 * 2)); height=$((width * 9 / 16 / 2 * 2))
  fi
}

if [[ -z "$width" || -z "$height" ]]; then
  layout="$orientation"
  if [[ "$layout" == auto ]]; then
    if ((desktop_h > desktop_w)); then layout=portrait; else layout=landscape; fi
  fi
  choose_resolution "$layout"
fi
if [[ "$orientation" == portrait && "$width" -gt "$height" ]]; then t="$width"; width="$height"; height="$t"; fi
if [[ "$orientation" == landscape && "$width" -lt "$height" ]]; then t="$width"; width="$height"; height="$t"; fi
if [[ "$height" -gt $((desktop_h - 40)) || "$width" -gt "$desktop_w" ]]; then
  layout="$orientation"
  if [[ "$layout" == auto ]]; then
    if ((height > width)); then layout=portrait; else layout=landscape; fi
  fi
  choose_resolution "$layout"
fi

if ((save)); then
  install -d -m 0700 "$(dirname "$config")"
  printf 'ANBOX_ORIENTATION=%q\nANBOX_WIDTH=%q\nANBOX_HEIGHT=%q\n' "$orientation" "$width" "$height" >"$config"
fi

exec 9>"$lock"
flock -n 9 || error "Another Anbox Reboxed launcher is already starting"

service_start() {
  if systemctl is-active --quiet anbox-container-manager.service; then return 0; fi
  if command -v pkexec >/dev/null; then
    pkexec systemctl start anbox-container-manager.service || error "Container service could not be started"
  else
    error "anbox-container-manager.service is inactive; start it as root"
  fi
}

service_restart() {
  if command -v pkexec >/dev/null; then
    pkexec systemctl restart anbox-container-manager.service || error "Container service could not be restarted"
  else
    error "Anbox Reboxed needs a container-service restart; run: sudo systemctl restart anbox-container-manager.service"
  fi
}

session_healthy() {
  "$ANBOX_BIN" shell -c 'test "$(getprop sys.boot_completed)" = 1' >/dev/null 2>&1
}

wait_for_previous_container() {
  # Closing the final SDL window stops Android asynchronously.  Do not send a
  # new start request while the previous LXC instance still answers shell
  # commands: the manager treats it as already running, then the old teardown
  # leaves the replacement session with a stopped container.
  for _ in {1..30}; do
    "$ANBOX_BIN" shell -c true >/dev/null 2>&1 || return 0
    sleep 1
  done
  service_restart
  for _ in {1..15}; do
    "$ANBOX_BIN" shell -c true >/dev/null 2>&1 || return 0
    sleep 1
  done
  error "Previous Android container did not stop"
}

if pgrep -u "$UID" -f '[/](anbox|anbox-reboxed) session-manager' >/dev/null; then
  if session_healthy; then
    "$ANBOX_BIN" shell -c 'am start -a android.intent.action.MAIN -c android.intent.category.HOME' >/dev/null 2>&1 || true
    exit 0
  fi
  # A dead renderer/client can outlive its Android container. Remove only the
  # caller's stale session; the manager is restarted below if a new boot fails.
  pkill -TERM -u "$UID" -f '[/](anbox|anbox-reboxed) session-manager' || true
  for _ in {1..10}; do pgrep -u "$UID" -f '[/](anbox|anbox-reboxed) session-manager' >/dev/null || break; sleep 1; done
  pgrep -u "$UID" -f '[/](anbox|anbox-reboxed) session-manager' >/dev/null && pkill -KILL -u "$UID" -f '[/](anbox|anbox-reboxed) session-manager' || true
fi

service_start
wait_for_previous_container

log="${XDG_STATE_HOME:-$HOME/.local/state}/anbox/session.log"
install -d -m 0700 "$(dirname "$log")"
for attempt in 1 2; do
  "$ANBOX_BIN" session-manager --single-window --window-size="${width}x${height}" \
    --orientation="$orientation" --no-touch-emulation --no-dbus-service >"$log" 2>&1 &
  session_pid=$!
  for _ in {1..180}; do
    kill -0 "$session_pid" 2>/dev/null || break
    if session_healthy; then
      "$ANBOX_BIN" shell -c 'am start -a android.intent.action.MAIN -c android.intent.category.HOME' >/dev/null || error "HOME activity failed"
      wait "$session_pid"
      exit $?
    fi
    sleep 1
  done
  kill -TERM "$session_pid" 2>/dev/null || true
  wait "$session_pid" 2>/dev/null || true
  (( attempt == 1 )) || break
  # A clean window close normally needs no service action. Only retry with a
  # manager restart when the first replacement session failed to boot.
  service_restart
done
error "Android did not boot; the manager was restarted once. See $log"
