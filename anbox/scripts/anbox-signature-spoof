#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tempfile


FORMAT = "anbox-reboxed-signature-spoof-v1"
GENERATION_RE = re.compile(r"^android-15-reboxed-v1-[0-9a-f]{16}-[0-9a-f]{8}$")
INIT_RC = """# Generated by anbox-signature-spoof; managed overlay only.
on property:sys.boot_completed=1
    exec_background u:r:init:s0 root root -- /system/bin/pm grant --user 0 app.revanced.android.gms android.permission.FAKE_PACKAGE_SIGNATURE
    exec_background u:r:init:s0 root root -- /system/bin/pm grant --user 0 com.android.vending android.permission.FAKE_PACKAGE_SIGNATURE
"""


class SpoofError(RuntimeError):
    pass


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_text(path, value, mode=0o600):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp.%d" % os.getpid())
    with open(temporary, "x", encoding="utf-8") as output:
        output.write(value)
        output.flush()
        os.fsync(output.fileno())
    os.chmod(temporary, mode)
    os.replace(temporary, path)
    fsync_directory(path.parent)


def state_root(args):
    return pathlib.Path(args.data_dir) / "state/signature-spoof"


def marker_value(path):
    value = path.read_text(encoding="utf-8").strip()
    if not GENERATION_RE.fullmatch(value):
        raise SpoofError("invalid signature-spoof generation marker")
    return value


def container_running(args):
    result = subprocess.run(
        ["lxc-info", "-P", args.container_path, "-n", args.container, "-sH"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return result.returncode == 0 and result.stdout.strip() == "RUNNING"


def require_offline(args):
    if os.geteuid() != 0:
        raise SpoofError("this action must run as root")
    if container_running(args):
        raise SpoofError("stop the Android container before changing the active signature overlay")


def ensure_secure(path, kind):
    info = path.lstat()
    expected = stat.S_IFDIR if kind == "directory" else stat.S_IFREG
    if stat.S_IFMT(info.st_mode) != expected or info.st_uid != 0:
        raise SpoofError("insecure %s: %s" % (kind, path))
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise SpoofError("group/world-writable managed path: %s" % path)


def validate_generation(args, generation):
    if not GENERATION_RE.fullmatch(generation):
        raise SpoofError("invalid generation name")
    root = state_root(args) / "generations" / generation
    ensure_secure(root, "directory")
    services = root / "services.jar"
    permission_dir = root / "system-app"
    permission_apk = permission_dir / "ReboxedSignatureSpoofPermission.apk"
    init_rc = root / "reboxed-signature-spoof.rc"
    manifest = root / "manifest.json"
    for path in (services, permission_apk, init_rc, manifest):
        ensure_secure(path, "file")
    ensure_secure(permission_dir, "directory")
    data = json.loads(manifest.read_text(encoding="utf-8"))
    if data.get("format") != FORMAT or data.get("generation") != generation:
        raise SpoofError("generation manifest does not match its directory")
    if data.get("patched_services_sha256") != sha256(services):
        raise SpoofError("patched services.jar checksum mismatch")
    if data.get("permission_apk_sha256") != sha256(permission_apk):
        raise SpoofError("permission APK checksum mismatch")
    return root, data


def prepare(args):
    require_offline(args)
    source_jar = pathlib.Path(args.services_jar).resolve()
    permission_apk = pathlib.Path(args.permission_apk).resolve()
    policy_path = pathlib.Path(args.policy).resolve()
    for path in (source_jar, permission_apk, policy_path,
                 pathlib.Path(args.builder), pathlib.Path(args.patch_helper),
                 pathlib.Path(args.baksmali_jar), pathlib.Path(args.smali_jar)):
        if not path.is_file():
            raise SpoofError("missing preparation input: " + str(path))
    policy = json.loads(policy_path.read_text(encoding="utf-8"))
    if policy.get("format") != FORMAT:
        raise SpoofError("unsupported signature-spoof policy")
    if sha256(source_jar) != policy["services_jar_sha256"]:
        raise SpoofError("services.jar does not match the audited Android 15 build")

    root = state_root(args)
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    generations = root / "generations"
    generations.mkdir(mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="signature-spoof-", dir=str(root)) as raw:
        staging = pathlib.Path(raw)
        patched = staging / "services.jar"
        subprocess.run([
            args.builder, str(source_jar), str(patched), args.source_root,
            args.sdk_root, args.baksmali_jar, args.smali_jar, args.patch_helper,
        ], check=True)
        patched_hash = sha256(patched)
        permission_hash = sha256(permission_apk)
        generation = "android-15-reboxed-v1-%s-%s" % (
            patched_hash[:16], permission_hash[:8])
        destination = generations / generation
        if destination.exists():
            validate_generation(args, generation)
        else:
            build = generations / ("." + generation + ".tmp.%d" % os.getpid())
            build.mkdir(mode=0o700)
            shutil.copyfile(patched, build / "services.jar")
            (build / "system-app").mkdir(mode=0o755)
            shutil.copyfile(permission_apk,
                            build / "system-app/ReboxedSignatureSpoofPermission.apk")
            (build / "reboxed-signature-spoof.rc").write_text(INIT_RC,
                                                                encoding="utf-8")
            manifest = dict(policy)
            manifest.update({
                "generation": generation,
                "source_services_sha256": sha256(source_jar),
                "patched_services_sha256": patched_hash,
                "permission_apk_sha256": permission_hash,
            })
            (build / "manifest.json").write_text(
                json.dumps(manifest, indent=2, sort_keys=True) + "\n",
                encoding="utf-8")
            for path in build.rglob("*"):
                os.chmod(path, 0o755 if path.is_dir() else 0o644)
            os.chmod(build, 0o700)
            os.rename(build, destination)
            fsync_directory(generations)
        atomic_text(root / "prepared", generation + "\n")
    print("Prepared signature-spoof generation: " + generation)
    print("The overlay is not active until 'enable' and a container restart.")


def enable(args):
    require_offline(args)
    root = state_root(args)
    generation = args.generation
    if not generation:
        prepared = root / "prepared"
        if not prepared.is_file():
            raise SpoofError("no prepared generation; run prepare first")
        generation = marker_value(prepared)
    validate_generation(args, generation)
    atomic_text(root / "enabled", generation + "\n")
    print("Enabled signature-spoof generation: " + generation)


def disable(args):
    require_offline(args)
    marker = state_root(args) / "enabled"
    marker.unlink(missing_ok=True)
    if marker.parent.is_dir():
        fsync_directory(marker.parent)
    print("Signature spoofing disabled; prepared generations were retained.")


def status(args):
    root = state_root(args)
    prepared = root / "prepared"
    enabled = root / "enabled"
    prepared_value = marker_value(prepared) if prepared.is_file() else "none"
    enabled_value = marker_value(enabled) if enabled.is_file() else "none"
    if prepared_value != "none":
        validate_generation(args, prepared_value)
    if enabled_value != "none":
        _, manifest = validate_generation(args, enabled_value)
        print("authorized-packages: " + ",".join(
            item["package"] for item in manifest["authorized_packages"]))
    print("prepared-generation: " + prepared_value)
    print("enabled-generation: " + enabled_value)
    print("enabled: " + str(enabled_value != "none").lower())


def parser():
    result = argparse.ArgumentParser(
        description="Manage the cert-pinned Android 15 signature-spoof overlay")
    result.add_argument("action", choices=("prepare", "enable", "disable", "status"))
    result.add_argument("--data-dir", default="/var/lib/anbox")
    result.add_argument("--container-path", default="/var/lib/anbox/containers")
    result.add_argument("--container", default="default")
    result.add_argument("--generation")
    result.add_argument("--services-jar")
    result.add_argument("--permission-apk",
                        default="/usr/local/share/anbox/signature-spoof/ReboxedSignatureSpoofPermission.apk")
    result.add_argument("--policy",
                        default="/usr/local/share/anbox/signature-spoof/android-15-reboxed-v1.json")
    result.add_argument("--source-root",
                        default="/usr/local/share/anbox/signature-spoof/framework-source")
    result.add_argument("--sdk-root", default=os.environ.get("ANDROID_SDK_ROOT", ""))
    result.add_argument("--baksmali-jar")
    result.add_argument("--smali-jar")
    result.add_argument("--builder", default="/usr/local/lib/anbox/build-signature-spoof-framework")
    result.add_argument("--patch-helper", default="/usr/local/lib/anbox/patch-signature-spoof-smali")
    return result


def main():
    args = parser().parse_args()
    try:
        if args.action == "prepare":
            required = {
                "--services-jar": args.services_jar,
                "--sdk-root": args.sdk_root,
                "--baksmali-jar": args.baksmali_jar,
                "--smali-jar": args.smali_jar,
            }
            missing = [name for name, value in required.items() if not value]
            if missing:
                raise SpoofError("prepare requires " + ", ".join(missing))
            prepare(args)
        elif args.action == "enable":
            enable(args)
        elif args.action == "disable":
            disable(args)
        else:
            status(args)
    except (OSError, subprocess.CalledProcessError, SpoofError, ValueError) as error:
        print("signature-spoof: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
