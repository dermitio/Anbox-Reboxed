<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.anbox.reboxed.nativebridge.probe"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:label="Reboxed Native Bridge Probe">
        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <instrumentation
        android:name=".ProbeInstrumentation"
        android:exported="false"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:targetPackage="org.anbox.reboxed.nativebridge.probe" />
</manifest>
